# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL where this applet is hosted.
APP_URL="http://localhost:3000"
PORT=3000

# JWT Authentication Secret
JWT_SECRET="musiclab_super_secret_jwt_key_academic_demo_2026"

# MySQL Database Configuration (Opcional si se conecta a servidor MySQL externo)
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="musiclab_user"
DB_PASSWORD="change_with_secure_password"
DB_NAME="musiclab_db"

# Entidad local a la que se destina la propuesta académica
# (Reemplazar por la entidad real de tu localidad si la actividad lo exige)
COMMUNITY_ENTITY_NAME="Asociación Musical y Cultural Sonora"
